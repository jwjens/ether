.env.development

# Migration diagnostic snapshots (runtime output, never committed)
scripts/pre-*snapshot*.txt
scripts/post-*snapshot*.txt
scripts/*.log

# Runtime logs
electron-launch*.log

# One-off diagnostic scripts (kept on disk for reference, not committed)
scripts/diag-*.js

# EXCEPT the ones that produce RECEIPTS. These are not one-off diagnostics and they do not expire:
# they are how a claim about a BUILT ARTIFACT gets proved, and every future artifact needs them.
# Two releases shipped a dead BYPASS button that looked exactly like a working one, and what settled
# it was running these against the packaged .node - not reading the source. They stay committed and
# stay OUT of the installer: electron-builder.json excludes "**/scripts/diag-*.js", so keeping the
# diag- prefix means the packaging rule needs no change and the eight scripts/verify-*.js that DO
# ship are untouched.
!scripts/diag-levels-echo.js
!scripts/diag-c5-artifact.js
!scripts/diag-bypass-roundtrip.js
!scripts/diag-branch-split.js

# Generated diagnostic output
scripts/table-audit.js
scripts/dump-all-cols.js

# Claude Code local settings
.claude/settings.local.json

# Rust audio debug artifacts
debug-stream.f32le
dist-electron/

# Saved web pages (browser "Save As" artifacts) — never commit. A defunct saved page
# once leaked an (inert) Google API key; cleaned up 2026-07-26. These patterns block the
# saved-page asset folders and browser download parts so a "Save As" can't land here again.
*_files/
*.download

# ── Loose credential notes — NEVER commit (2026-08-09) ────────────────────────────────────────
# "key iris.txt" and "keys  - weather.txt" were committed and reached git history; both keys are
# being rotated. Scratch .txt notes are how keys keep landing in this repo, so the default for a
# root .txt is now IGNORED and anything genuinely belonging in git must be named explicitly below.
*.txt
*.keys

# Legitimate tracked .txt files, re-allowed by name. .gitignore does not affect files already
# tracked, so these are unaffected today — the negations exist so that re-adding one, or adding a
# sibling, does not silently fail with the blanket rule above.
!project_map.txt
!docs/push-state-*.txt
!scripts/pre-migration-snapshot-kv.txt
!scripts/post-migration-snapshot-kv.txt

# Local-only bulk artifacts — never history.
#
# temp-extract/ is a 512 MB unpacked build (it carries its own node_modules), and
# native/*.bak-* are 4 MB binary snapshots of the compiled addon taken before each
# audio slice (aux device, aux monitor, def telemetry, post-fader, slice 1). Both are
# scratch: recreatable, machine-local, and together ~533 MB. They are ignored rather
# than deleted because the .bak- addons are the rollback path for the audio work.
temp-extract/
native/*.bak-*

# Credentials — never commit, never package (leaked via broken win.files, 4.4.233–4.6.22)
key iris.txt
keys  - weather.txt
deepseek api.txt
ether-guests-couldflare-keys-tokens.txt
*.dump
openair.db
openair-backup.db
