{
    "name":  "openair",
    "version":  "0.1.0",
    "description":  "Free broadcast automation for internet streamers and small stations",
    "license":  "MIT",
    "scripts":  {
                    "dev":  "vite",
                    "tauri":  "tauri",
                    "tauri:dev":  "tauri dev",
                    "tauri:build":  "tauri build",
                    "lint":  "eslint src --ext .ts,.tsx",
                    "test":  "vitest",
                    "electron:start":  "electron electron/main.js",
                    "electron:dev":  "concurrently \"npm run dev\" \"wait-on http://localhost:1420 \u0026\u0026 electron electron/main.js\"",
                    "build":  "vite build",
                    "electron:build:win":  "electron-builder --win",
                    "electron:build:mac":  "electron-builder --mac",
                    "electron:build:linux":  "electron-builder --linux"
                },
    "dependencies":  {
                         "@picovoice/porcupine-react":  "^4.0.0",
                         "@picovoice/web-voice-processor":  "^4.0.9",
                         "@tauri-apps/api":  "^2.0.0",
                         "@tauri-apps/plugin-autostart":  "^2.0.0",
                         "@tauri-apps/plugin-dialog":  "^2.0.0",
                         "@tauri-apps/plugin-fs":  "^2.0.0",
                         "@tauri-apps/plugin-process":  "^2.3.1",
                         "@tauri-apps/plugin-shell":  "^2.0.0",
                         "@tauri-apps/plugin-sql":  "^2.0.0",
                         "@tauri-apps/plugin-updater":  "^2.10.0",
                         "better-sqlite3":  "^12.8.0",
                         "date-fns":  "^3.6.0",
                         "lamejs":  "^1.2.1",
                         "music-metadata":  "^11.12.3",
                         "react":  "^18.3.0",
                         "react-dom":  "^18.3.0",
                         "react-router-dom":  "^6.26.0",
                         "uuid":  "^10.0.0",
                         "zustand":  "^5.0.0"
                     },
    "devDependencies":  {
                            "@electron/rebuild":  "^4.0.3",
                            "@napi-rs/cli":  "^3.6.0",
                            "@tauri-apps/cli":  "^2.0.0",
                            "@types/react":  "^18.3.0",
                            "@types/react-dom":  "^18.3.0",
                            "@types/uuid":  "^10.0.0",
                            "@vitejs/plugin-react":  "^4.3.0",
                            "autoprefixer":  "^10.4.0",
                            "concurrently":  "^9.2.1",
                            "electron":  "^41.1.0",
                            "electron-builder":  "^26.8.1",
                            "eslint":  "^9.0.0",
                            "postcss":  "^8.4.0",
                            "tailwindcss":  "^3.4.0",
                            "typescript":  "^5.5.0",
                            "vite":  "^7.3.1",
                            "vitest":  "^4.0.18",
                            "wait-on":  "^9.0.4"
                        }
}
