{
  "appId": "com.ether.radio",
  "productName": "Ether",
  "copyright": "Copyright © 2026 Ether",
  "directories": {
    "output": "dist-electron",
    "buildResources": "build-resources"
  },
  "asarUnpack": [
    "node_modules/ffmpeg-static/**",
    "watchdog/**",
    "audiod/**",
    "native/**/*.node",
    "electron/sync/mutation-writer.js",
    "electron/sync/synced-tables.js",
    "electron/audio-library-index.js"
  ],
  "files": [
    "dist/**/*",
    "electron/**/*",
    "audiod/**/*",
    "scripts/**/*.js",
    "!**/scripts/diag-*.js",
    "native/**/*.node",
    "watchdog/**/*",
    "!watchdog/test/**",
    "!audiod/**/*.test.js",
    "!electron/**/*.test.js",
    "!electron/sync/tests/**",
    "!docs/**",
    "!temp-extract/**",
    "!node_modules/onnxruntime-node/bin/napi-v3/linux/**",
    "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
    "!node_modules/better-sqlite3/prebuilds/darwin-*",
    "!node_modules/better-sqlite3/prebuilds/linux-*",
    "!node_modules/better-sqlite3/prebuilds/linuxmusl-*",
    "node_modules/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "native",
      "to": "native",
      "filter": ["**/*.node"]
    },
    {
      "from": "native/ha-setup/target/release/ha-setup.exe",
      "to": "ha-setup.exe"
    }
  ],
  "npmRebuild": false,
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "build-resources/icon.ico",
    "_signExts_why": [
      "NOT a blanket '.node'. electron-builder's shouldSignFile (app-builder-lib/out/winPackager.js",
      ":197-214) is an endsWith() SUFFIX compare and it tests POSITIVE patterns BEFORE negative '!'",
      "ones, so '.node' can never be narrowed by a '!' entry — the positive always wins. A blanket",
      "'.node' therefore selected onnxruntime-node's LINUX and DARWIN prebuilds, which ship inside",
      "the Windows package. Authenticode cannot sign an ELF/Mach-O, and the v4.6.47 tag build died on",
      "exactly that: 'SignTool Error: This file format cannot be signed because it is not recognized'",
      "on .../onnxruntime-node/bin/napi-v3/linux/x64/onnxruntime_binding.node. It was NOT a secrets",
      "failure: Azure Trusted Signing had already authenticated and invoked signtool.",
      "So the WINDOWS binaries are enumerated instead. Files matching nothing are dropped by the",
      "collection walk (winPackager.js:248 passes fallbackValue=false); the '!' entries state that",
      "outcome explicitly instead of leaving it to a fallback. Both separator spellings appear because",
      "the compare is a raw suffix match on native paths.",
      "Ether.exe and the uninstaller are untouched — shouldSignFile short-circuits on '.exe' (:198).",
      "Guarded by scripts/smoke-sign-filter.js. docs/category-delete-silent-2026-09-24.md is unrelated."
    ],
    "signExts": [
      ".dll",
      "ether-audio.node",
      "win32-x64.node",
      "win32-arm64.node",
      "win32\\x64\\onnxruntime_binding.node",
      "win32\\arm64\\onnxruntime_binding.node",
      "win32/x64/onnxruntime_binding.node",
      "win32/arm64/onnxruntime_binding.node",
      "!darwin-x64.node",
      "!darwin-arm64.node",
      "!linux-x64.node",
      "!linux-arm64.node",
      "!linuxmusl-x64.node",
      "!linuxmusl-arm64.node",
      "!darwin\\x64\\onnxruntime_binding.node",
      "!darwin\\arm64\\onnxruntime_binding.node",
      "!linux\\x64\\onnxruntime_binding.node",
      "!linux\\arm64\\onnxruntime_binding.node",
      "!darwin/x64/onnxruntime_binding.node",
      "!darwin/arm64/onnxruntime_binding.node",
      "!linux/x64/onnxruntime_binding.node",
      "!linux/arm64/onnxruntime_binding.node"
    ],
    "extraFiles": [
      {
        "from": "build-resources/Reset Ether Data.bat",
        "to": "Reset Ether Data.bat"
      }
    ]
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] }
    ],
    "icon": "build-resources/icon.icns",
    "category": "public.app-category.music",
    "entitlements": "build-resources/entitlements.mac.plist",
    "entitlementsInherit": "build-resources/entitlements.mac.plist",
    "hardenedRuntime": true
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] }
    ],
    "icon": "build-resources/icon.png",
    "category": "Audio"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "include": "build-resources/installer.nsh"
  },
  "publish": {
    "provider": "github",
    "owner": "jwjens",
    "repo": "ether",
    "releaseType": "release"
  }
}
